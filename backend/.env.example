# ─── App ──────────────────────────────────────────────────────────
PROJECT_NAME=PackPal AI
PROJECT_VERSION=1.0.0
# development | production
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins for CORS
BACKEND_CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────
# PostgreSQL connection string using psycopg3 driver (psycopg)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/packpal_ai

# ─── AI Provider ──────────────────────────────────────────────────
# gemini | mock  (mock uses deterministic responses without API key)
AI_PROVIDER=gemini

# Google Gemini API key — get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use (gemini-2.0-flash-lite is the fastest lightweight model)
GEMINI_MODEL=gemini-2.0-flash-lite

# AI response temperature: 0.0 = deterministic, 1.0 = creative
AI_TEMPERATURE=0.3

# ─── Auth ─────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret before deployment
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
# Token expiry time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Email (Resend) ───────────────────────────────────────────────
# Leave blank to stay in development mode (reset link returned in API response).
# Set both fields to enable real email delivery via Resend (https://resend.com).
#
# Setup (free plan: 100 emails/day, 3 000 emails/month):
#   1. Sign up at https://resend.com
#   2. Add and verify your sending domain
#   3. Create an API key at https://resend.com/api-keys
#   4. Fill in the values below and restart the backend
#
# RESEND_API_KEY    — starts with "re_"
# RESEND_FROM_EMAIL — must be from a domain verified in your Resend account
#                     (use "onboarding@resend.dev" for initial testing with the sandbox)
#
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=PackPal AI
